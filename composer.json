{
    "name": "marcelofecchio/siscomex",
    "description": "SDK PHP 8.4 para a API Pública do Portal Único Siscomex: autenticação (IMPEXP), Cadastro de Atributos e Catálogo de Produtos.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "siscomex",
        "portal unico",
        "pucomex",
        "catalogo de produtos",
        "cadastro de atributos",
        "duimp",
        "comercio exterior",
        "sdk"
    ],
    "authors": [
        {
            "name": "Marcelo Fecchio",
            "homepage": "https://github.com/marcelofecchio"
        }
    ],
    "support": {
        "issues": "https://github.com/marcelofecchio/siscomex/issues",
        "source": "https://github.com/marcelofecchio/siscomex",
        "docs": "https://github.com/marcelofecchio/siscomex#readme"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Cliente HTTP PSR-18 padrão; necessário para autenticação mTLS com certificado A1.",
        "symfony/cache": "Implementação PSR-16 alternativa para armazenar a sessão (via Psr16TokenStore).",
        "ext-curl": "Necessário para mTLS com certificado A1 via Guzzle.",
        "ext-openssl": "Necessário para converter certificados .pfx em PEM.",
        "ext-zip": "Necessário para os downloads/exportações que retornam ZIP."
    },
    "autoload": {
        "psr-4": {
            "MarceloFecchio\\Siscomex\\PortalUnico\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarceloFecchio\\Siscomex\\PortalUnico\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:coverage": "phpunit --testsuite unit --coverage-text",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs:check",
            "@analyse",
            "@test"
        ]
    }
}
