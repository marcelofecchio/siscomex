# Copie para .env (que NÃO é versionado) e preencha. Nunca commite valores reais.

# validacao | producao
SISCOMEX_AMBIENTE=validacao

# Chaves de Acesso (Perfil do usuário → Chaves de acesso, no ambiente correspondente)
SISCOMEX_CLIENT_ID=
SISCOMEX_CLIENT_SECRET=

# OU certificado A1 e-CPF (.pfx/.p12 ou .pem). Se definido, tem prioridade sobre as chaves.
SISCOMEX_CERT_PATH=
SISCOMEX_CERT_SENHA=

# CNPJ raiz (8 primeiros caracteres) ou CPF do responsável pelo catálogo
SISCOMEX_CNPJ_RAIZ=

# Testes de integração (tests/Integration) — só rodam com 1 e somente contra validacao
SISCOMEX_RUN_INTEGRATION=0
# NCM usada nos testes de integração
SISCOMEX_NCM_TESTE=84733049
